<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:gravity="center" android:orientation="vertical" android:padding="2dp">

    <FrameLayout android:id="@+id/time_box"
        android:layout_width="match_parent" android:layout_height="184dp">
        <TextClock android:id="@+id/widget_time"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="bottom|center_horizontal" android:maxLines="1" android:includeFontPadding="false"
            android:fontFamily="sans-serif" android:format12Hour="h:mm" android:format24Hour="h:mm"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp"
            android:autoSizeMaxTextSize="220sp" android:autoSizeStepGranularity="1px"
            android:textColor="#FFFFFF"
            android:shadowColor="#B0000000" android:shadowRadius="2" android:shadowDy="1" />
    </FrameLayout>

    <TextClock android:id="@+id/widget_date"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:maxLines="1" android:includeFontPadding="false"
        android:format12Hour="EEEE MMMM d" android:format24Hour="EEEE MMMM d"
        android:textSize="30sp" android:textColor="#FFFFFF"
        android:shadowColor="#B0000000" android:shadowRadius="2" android:shadowDy="1" />

    <LinearLayout android:id="@+id/weather_row"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:orientation="horizontal">
        <ImageView android:id="@+id/weather_icon"
            android:layout_width="18dp" android:layout_height="18dp"
            android:layout_marginEnd="4dp" android:importantForAccessibility="no"
            android:visibility="gone" />
        <TextView android:id="@+id/widget_weather"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:gravity="center" android:maxLines="1" android:includeFontPadding="false"
            android:textSize="30sp" android:textColor="#FFFFFF"
            android:shadowColor="#B0000000" android:shadowRadius="2" android:shadowDy="1" />
    </LinearLayout>
</LinearLayout>
